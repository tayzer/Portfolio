@page "/projects"
@inject ProjectService ProjectSvc

<p class="eyebrow">Selected work / Project files</p>
<h1>My Projects<span class="heading-period">.</span></h1>
<hr />

@if (isLoading)
{
    <p>Loading projects...</p>
}
else if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <p>@errorMessage</p>
}
else if (projects.Count == 0)
{
    <p>No projects available.</p>
}
else
{
    <div class="project-gallery">
        @foreach (var project in projects)
        {
            <article class="project-card">
                <img src="@project.ImageUrl" alt="@project.Title" loading="lazy" decoding="async" style="width:100%;" />
                <p class="project-label">Project file / @string.Join(" · ", project.Technologies)</p>
                <h2>@project.Title</h2>
                <p>@project.Summary</p>
                <NavLink href="@($"project/{project.Id}")">View Details <span aria-hidden="true">↗</span></NavLink>
            </article>
        }
    </div>
}

@code {
    private IReadOnlyList<Project> projects = Array.Empty<Project>();
    private bool isLoading = true;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            projects = await ProjectSvc.GetProjectsAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to load projects: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }
}
